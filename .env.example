# Redis address
REDIS_ADDR=127.0.0.1:6379

# PostgreSQL connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/nasa_space?sslmode=disable

# Open-Meteo archive API base URL
WEATHER_URI=https://archive-api.open-meteo.com/v1/archive

# Outbound API requests per second (rate limit)
REQUESTS_PER_SECOND=8
